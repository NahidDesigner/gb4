# macOS
.DS_Store
._*

# Editor / tooling scratch — not part of the site
.claude/
.codex/
.cursor/
.impeccable/
.superpowers/
.restore-points/
restore-points/

# Visual-QA captures — the AGENTS.md protocol generates paired desktop/mobile
# shots for every section edit. Kept local; they are verification, not source.
# Glob so new capture directories (qa-screenshots/, …) are covered on sight.
screenshots/
*screenshots/
artifacts/

# Python bytecode from the tests/ suite
__pycache__/
*.pyc

# Reference material, intentionally not published
original-untouched/

# Full-site working copies. Unreferenced duplicates of the tree above — keeping
# them tracked would double the source and make "which one is canonical" a
# guess. Remove an entry here if one ever becomes a real deploy target.
gb/
